# Required in production — used to sign JWT access tokens (server-only).
# Set this in Vercel → Project → Settings → Environment Variables.
# Generate a long random string (e.g. openssl rand -hex 32). Do not use the placeholder.
JWT_SECRET=change-me-in-production

# Required. PostgreSQL connection string (Supabase Session/Transaction pooler recommended).
# Login, registration, SME profiles, and all risk records use this database.
# Encode special characters in the password ($ @ # etc). Quote the value if it contains `$`.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Optional SMTP settings for alert emails (skipped gracefully if unset)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_PORT=587
# SMTP_SECURE=false
