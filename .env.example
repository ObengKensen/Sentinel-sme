# Required in production — used to sign JWT access tokens (server-only).
# Set this in Vercel → Project → Settings → Environment Variables.
# Generate a long random string (e.g. openssl rand -hex 32). Do not use the placeholder.
JWT_SECRET=change-me-in-production

# PostgreSQL connection string for shared accounts + risk data (Neon/Supabase/Railway recommended for Vercel).
# When set, login/register and SME risk records sync through the database instead of browser-only storage.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional SMTP settings for alert emails (skipped gracefully if unset)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_PORT=587
# SMTP_SECURE=false
