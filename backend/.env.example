PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sme_risk_sentinel

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=24h

# Frontend URL (CORS + email links)
FRONTEND_URL=http://localhost:5173

# Optional SMTP for alert emails (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Super Admin (seeded if not exists)
SUPER_ADMIN_EMAIL=admin@smerisksentinel.com
SUPER_ADMIN_PASSWORD=SuperAdmin2024!
